# Copy to .env and fill in to use a live model. If left unset, inboxHero runs
# fully offline on deterministic heuristics (recommended for grading).

# Provider: offline | gemini | openai-compatible
INBOXHERO_LLM_PROVIDER=offline

# Which model, and the key. Never commit your real .env.
INBOXHERO_LLM_MODEL=gemini-1.5-flash
INBOXHERO_LLM_API_KEY=

# For a local model (Ollama / any OpenAI-compatible server):
# INBOXHERO_LLM_PROVIDER=openai-compatible
# INBOXHERO_LLM_BASE_URL=http://localhost:11434/v1
# INBOXHERO_LLM_MODEL=llama3.1:8b

# Free-tier politeness (seconds between calls) and retry budget for HTTP 429.
INBOXHERO_LLM_MIN_INTERVAL=4.0
INBOXHERO_LLM_MAX_RETRIES=5

# Optional overrides
# INBOXHERO_OWNER=sam@paperjet.io
# INBOXHERO_NOW=2026-09-12T09:00:00
